{
  "name": "dshgw-web-tty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive TTY panel for the dsh web GUI: a real node-pty behind one authenticated RPC channel, rendered by xterm.js in the shell overlay slot",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
