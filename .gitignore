# build artifacts
/bin/
*.exe

# runtime data (db, fallback ledgers, backups, plugin state)
/data/
*.db
*.db-wal
*.db-shm
billing-fallback.jsonl
hooks-dead.jsonl

# python bytecode from the ops scripts in scripts/
__pycache__/
*.pyc

# workspace-local toolchain caches (see scripts/goenv.sh)
/.cache/

# local deployment configuration: it carries the bootstrap admin password, API keys,
# the session secret and credentials_key, so it must never enter git history.
# Derive your own from config.example.yaml instead.
/config.yaml
# The same rule for the two side binaries' configurations (M63: they live at the deployment
# root, next to config.yaml). dshgw.yaml carries the Feishu ticket secret and this host's dsh
# runtime paths; gwproxy.yaml names the registry of the deployment it fronts.
/dshgw.yaml
/gwproxy.yaml

# built plugin binaries: `make plugin-example` writes bin/aigw-provider-*, and a
# deployment copies them into plugins/ (the directory the host scans for plugins).
# Neither is a source artifact, so ignore the discovery directory wholesale.
# The previous /plugins/*.bin pattern never matched the real names.
/plugins/

# runtime files of the tenant-side web plugins (M75). They normally live in each account's DSH
# home — the row names a per-tenant path — so anything appearing here came from a row without a
# traceFile (an out-of-tree run) or an interrupted test run, and must never be committed.
cmd/dshgw/plugin/*/trace.jsonl
cmd/dshgw/plugin/*/cache.json

# editors
.idea/
.vscode/
*.swp
.billing_report/
