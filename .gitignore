# build artifacts
/bin/
*.exe

# runtime data (db, fallback ledgers, backups, plugin state)
/data/
*.db
*.db-wal
*.db-shm
billing-fallback.jsonl
hooks-dead.jsonl

# python bytecode from the ops scripts in scripts/
__pycache__/
*.pyc

# workspace-local toolchain caches (see scripts/goenv.sh)
/.cache/

# local deployment configuration: it carries the bootstrap admin password, API keys,
# the session secret and credentials_key, so it must never enter git history.
# Derive your own from config.example.yaml instead.
/config.yaml

# built plugin binaries: `make plugin-example` writes bin/aigw-provider-*, and a
# deployment copies them into plugins/ (the directory the host scans for plugins).
# Neither is a source artifact, so ignore the discovery directory wholesale.
# The previous /plugins/*.bin pattern never matched the real names.
/plugins/

# editors
.idea/
.vscode/
*.swp
.billing_report/
