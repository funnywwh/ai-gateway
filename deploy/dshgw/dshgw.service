[Unit]
Description=Multi-tenant DeepSeek Harness gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dshgw
Group=dshgw
WorkingDirectory=/var/lib/dshgw
ExecStart=/opt/dshgw/bin/dshgw --config /etc/dshgw/config.yaml serve
Restart=always
RestartSec=2
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Keep parent directories mounted, not individual atomically replaced files.
ReadOnlyPaths=/etc/dshgw /var/lib/dshgw
ReadWritePaths=/var/lib/dshgw/gateway

[Install]
WantedBy=multi-user.target
